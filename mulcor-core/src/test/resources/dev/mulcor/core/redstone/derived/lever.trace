# DERIVED, NOT RECORDED: expected rows worked out tick by tick from the vanilla 26.2 source (see Redstone.java),
# not captured from a vanilla server. Re-record on a real server with the oracle before treating these as golden.
# Format as in ../*.trace, plus "use t x y z": a player uses the block (empty hand) between tick t and t+1.
build 0 0 0 stone
build 1 0 0 lever[face=wall,facing=east]
build -1 0 0 redstone_wire
build 4 0 0 lever[face=floor,facing=north]
build 5 0 0 redstone_lamp
use 0 1 0 0
use 0 4 0 0
use 5 1 0 0
use 5 4 0 0
probe wall 1 0 0
probe behind -1 0 0
probe floor 4 0 0
probe lamp 5 0 0
row 0 wall=lever[powered=true] behind=redstone_wire[power=15] floor=lever[powered=true] lamp=redstone_lamp[lit=true] primed_tnt=0
row 5 wall=lever[powered=false] behind=redstone_wire[power=0] floor=lever[powered=false]
row 9 lamp=redstone_lamp[lit=false]
end 12
