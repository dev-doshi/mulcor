# Vanilla 26.2 trace 'repeater_lock', recorded on a real server (/tick freeze + /tick step 1, RCON probes).
# Coordinates relative to the scenario origin; y=0 is the first air layer above a stone floor.
# build: /setblock before t=0 (then 4 ticks settle); action t: /setblock between tick t and t+1 (before
# the t row is probed); row t: probed states after t ticks (only changes after the first row).
build 1 0 0 redstone_wire
build 2 0 0 repeater[facing=west,delay=1]
build 3 0 0 redstone_lamp
build 2 0 1 repeater[facing=south,delay=1]
action 0 2 0 2 redstone_block
action 4 0 0 0 redstone_block
action 10 2 0 2 air
probe main 2 0 0
probe side 2 0 1
probe lamp 3 0 0
row 0 main=repeater[powered=false,locked=false] side=repeater[powered=false,locked=false] lamp=redstone_lamp[lit=false] primed_tnt=0
row 2 main=repeater[powered=false,locked=true] side=repeater[powered=true,locked=false]
row 12 main=repeater[powered=false,locked=false] side=repeater[powered=false,locked=false]
row 14 main=repeater[powered=true,locked=false] lamp=redstone_lamp[lit=true]
end 20
