# Vanilla 26.2 trace 'torch_inverter', recorded on a real server (/tick freeze + /tick step 1, RCON probes).
# Coordinates relative to the scenario origin; y=0 is the first air layer above a stone floor.
# build: /setblock before t=0 (then 4 ticks settle); action t: /setblock between tick t and t+1 (before
# the t row is probed); row t: probed states after t ticks (only changes after the first row).
build 0 0 0 redstone_wire
build 1 0 0 redstone_wire
build 2 0 0 stone
build 2 1 0 redstone_torch
build 2 2 0 redstone_lamp
action 0 -1 0 0 redstone_block
action 8 -1 0 0 air
probe w0 0 0 0
probe w1 1 0 0
probe torch 2 1 0
probe lamp 2 2 0
row 0 w0=redstone_wire[power=15] w1=redstone_wire[power=14] torch=redstone_torch[lit=true] lamp=redstone_lamp[lit=false] primed_tnt=0
row 2 torch=redstone_torch[lit=false]
row 8 w0=redstone_wire[power=0] w1=redstone_wire[power=0]
row 10 torch=redstone_torch[lit=true] lamp=redstone_lamp[lit=true]
end 20
