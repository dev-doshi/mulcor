# DERIVED, NOT RECORDED: expected rows worked out tick by tick from the vanilla 26.2 source (see Redstone.java),
# not captured from a vanilla server. Re-record on a real server with the oracle before treating these as golden.
# Format as in ../*.trace, plus "use t x y z": a player uses the block (empty hand) between tick t and t+1.
build 0 0 0 stone_button[face=floor,facing=north]
build 1 0 0 redstone_lamp
build 0 0 2 oak_button[face=floor,facing=north]
build 1 0 2 redstone_lamp
use 0 0 0 0
use 0 0 0 2
use 5 0 0 0
probe stone 0 0 0
probe lamp_s 1 0 0
probe oak 0 0 2
probe lamp_o 1 0 2
row 0 stone=stone_button[powered=true] lamp_s=redstone_lamp[lit=true] oak=oak_button[powered=true] lamp_o=redstone_lamp[lit=true] primed_tnt=0
row 20 stone=stone_button[powered=false]
row 24 lamp_s=redstone_lamp[lit=false]
row 30 oak=oak_button[powered=false]
row 34 lamp_o=redstone_lamp[lit=false]
end 40
