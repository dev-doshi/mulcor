# Vanilla 26.2 trace 'repeater_delays', recorded on a real server (/tick freeze + /tick step 1, RCON probes).
# Coordinates relative to the scenario origin; y=0 is the first air layer above a stone floor.
# build: /setblock before t=0 (then 4 ticks settle); action t: /setblock between tick t and t+1 (before
# the t row is probed); row t: probed states after t ticks (only changes after the first row).
build 1 0 0 repeater[facing=west,delay=1]
build 2 0 0 redstone_lamp
build 1 0 2 repeater[facing=west,delay=2]
build 2 0 2 redstone_lamp
build 1 0 4 repeater[facing=west,delay=3]
build 2 0 4 redstone_lamp
build 1 0 6 repeater[facing=west,delay=4]
build 2 0 6 redstone_lamp
action 0 0 0 0 redstone_block
action 12 0 0 0 air
action 0 0 0 2 redstone_block
action 12 0 0 2 air
action 0 0 0 4 redstone_block
action 12 0 0 4 air
action 0 0 0 6 redstone_block
action 12 0 0 6 air
probe r1 1 0 0
probe lamp1 2 0 0
probe r2 1 0 2
probe lamp2 2 0 2
probe r3 1 0 4
probe lamp3 2 0 4
probe r4 1 0 6
probe lamp4 2 0 6
row 0 r1=repeater[powered=false,locked=false] lamp1=redstone_lamp[lit=false] r2=repeater[powered=false,locked=false] lamp2=redstone_lamp[lit=false] r3=repeater[powered=false,locked=false] lamp3=redstone_lamp[lit=false] r4=repeater[powered=false,locked=false] lamp4=redstone_lamp[lit=false] primed_tnt=0
row 2 r1=repeater[powered=true,locked=false] lamp1=redstone_lamp[lit=true]
row 4 r2=repeater[powered=true,locked=false] lamp2=redstone_lamp[lit=true]
row 6 r3=repeater[powered=true,locked=false] lamp3=redstone_lamp[lit=true]
row 8 r4=repeater[powered=true,locked=false] lamp4=redstone_lamp[lit=true]
row 14 r1=repeater[powered=false,locked=false]
row 16 r2=repeater[powered=false,locked=false]
row 18 lamp1=redstone_lamp[lit=false] r3=repeater[powered=false,locked=false]
row 20 lamp2=redstone_lamp[lit=false] r4=repeater[powered=false,locked=false]
row 22 lamp3=redstone_lamp[lit=false]
row 24 lamp4=redstone_lamp[lit=false]
end 30
